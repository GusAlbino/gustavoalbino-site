{
  // Configuracao do Cloudflare Workers para um site estatico.
  //
  // Precisa bater exatamente com o nome do projeto criado na Cloudflare. Se
  // divergir, o deploy vai para outro Worker e a URL em uso continua servindo
  // o conteudo antigo. Ja aconteceu uma vez neste projeto.
  "name": "gustavoalbino-site",
  "compatibility_date": "2026-09-07",

  // Sem script: o site sao paginas HTML reais, uma por rota, geradas por
  // tools/gerar-paginas.mjs. /cases serve cases.html, /en serve en.html e
  // /en/cases serve en/cases.html pela regra de HTML dos assets (padrao
  // "auto-trailing-slash"). Caminho que nao existe sai 404 de verdade.
  // Historico: o app antigo precisava de um worker para servir o index.html em
  // toda rota e para costurar o <head>; isso acabou com a troca por paginas.
  "assets": {
    // Somente o conteudo publicado. README, docs/ e tools/ ficam de fora.
    "directory": "./public"
  }
}
